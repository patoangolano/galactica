{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "license": "${license}",
  "icon": "assets/galactica/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.galactica.Galactica", "dev.galactica.compat.CompatBootstrap"],
    "client": ["dev.galactica.client.GalacticaClient"],
    "modmenu": ["dev.galactica.compat.modmenu.GalacticaModMenu"]
  },
  "mixins": [
    {"config": "galactica.client.mixins.json", "environment": "client"},
    "galactica.planet.mixins.json",
    "galactica.nav.mixins.json",
    {"config": "galactica.perf.mixins.json", "environment": "client"}
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "iris": "*",
    "sodium": "*",
    "distanthorizons": ">=3.3.4",
    "bobby": "*",
    "modmenu": "*",
    "yet_another_config_lib_v3": "*",
    "geckolib": ">=5.5.7 <5.6",
    "tectonic": ">=3.0.31",
    "lithostitched": ">=2.0.4",
    "terralith": "*",
    "sodium-extra": "*",
    "scalablelux": "*"
  }
}
